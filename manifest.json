{
  "manifest_version": 3,
  "name": "IP Spot",
  "description": "Check public IPv4 and IPv6, approximate IP location, and optional IP change alerts.",
  "version": "2.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IP Spot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://ipwho.is/*",
    "https://api.ipify.org/*",
    "https://api6.ipify.org/*"
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
