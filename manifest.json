{
  "manifest_version": 3,
  "name": "IP Spot",
  "description": "View your public IP and approximate location, detect changes, and keep a local history.",
  "version": "2.1.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IP Spot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://ipwho.is/*"
  ],
  "permissions": [
    "storage"
  ]
}
